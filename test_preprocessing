"""
Simple test script for analyze_text().

Run from the project root:
    python services/test_preprocessing.py
"""

import sys
from pathlib import Path

# Add the project root so "services" can be imported when run directly.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from services.preprocessing import analyze_text

# Helps Windows terminals print emojis correctly.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")

# Test comments to analyze
test_comments = [
    "Love this product 😍❤️",
    "Wow, amazing service 🙄",
    "#Nike #Adidas #Crypto buy now",
    "sooooo amazing!!!!!!",
    "This is terrible!!!",
    "😂😂😂",
]

print("Testing analyze_text() with sample comments\n")
print("=" * 60)

for i, comment in enumerate(test_comments, start=1):
    print(f"\nComment {i}: {comment!r}")
    result = analyze_text(comment)
    print("Result:")
    print(result)

print("\n" + "=" * 60)
print("Done!")


